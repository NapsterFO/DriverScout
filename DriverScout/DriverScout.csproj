<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.5.0</Version>
    <Company>Napster</Company>
    <Authors>Napster</Authors>
    <Product>DriverScout</Product>
    <Description>Поиск и обновление драйверов</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
    <PackageReference Include="SharpCompress" Version="0.50.7" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка окна и панели задач -->
    <Resource Include="Assets\app.ico" />
    <!-- Логотип в боковой панели и «О программе» -->
    <Resource Include="Assets\icon_512.png" />
    <!-- Иконки программ на вкладке «Для геймеров» -->
    <Resource Include="Assets\apps\*.png" />
    <!-- Генератор иконки — отдельная утилита, в приложение не входит -->
    <Compile Remove="tools\**" />
  </ItemGroup>

</Project>
